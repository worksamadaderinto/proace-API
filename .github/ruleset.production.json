{
  "name": "Production integrity \u2014 sole maintainer",
  "target": "branch",
  "enforcement": "disabled",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main",
        "refs/heads/master"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Supply-chain policy",
            "integration_id": null
          },
          {
            "context": "Test",
            "integration_id": null
          },
          {
            "context": "Security and Vulnerability Checks",
            "integration_id": null
          },
          {
            "context": "CodeQL",
            "integration_id": null
          },
          {
            "context": "Build API image",
            "integration_id": null
          }
        ]
      }
    }
  ]
}
