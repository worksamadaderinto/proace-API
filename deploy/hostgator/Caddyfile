{$API_DOMAIN} {
    encode zstd gzip
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy nginx:8080
    log {
        output stdout
        format json
    }
}
